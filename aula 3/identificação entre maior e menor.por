programa {
  funcao inicio() {
    inteiro n1, n2
     escreva("Digite o primeiro número: ")
    leia(n1)
    escreva("Digite o segundo número: ")
    leia(n2)
    
    se (n1 > n2) 
       
        escreva("O número ", n1, " é maior")
    senao
        se (n2 > n1) 
           
            escreva("O número ", n2, " é maior")

        senao
            escreva("Os números são iguais")
  }
            }
